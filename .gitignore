# ============================
# Package Manager
# ============================

# Ignore package cache except manifest.json & packages-lock.json
Packages/manifest.json.meta
Packages/packages-lock.json.meta

# These auto-generate and should not be tracked
Packages/com.unity.package-manager-ui/
Packages/com.unity.collab-proxy/
Packages/com.unity.ide.visualstudio/
Packages/com.unity.ide.rider/

